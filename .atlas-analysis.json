  "keyFeatures": [
    "Send gift cards, reward links, and reward points to employees and customers",
    "Create and manage customizable reward campaigns",
    "Native integrations with HubSpot, Salesforce, Zoho CRM, SurveyMonkey, Qualtrics, and more",
    "Reward automation via Zapier and workflow-based triggers",
    "Global reward storefront with thousands of brands",
    "Prepaid virtual cards (Visa, PayPal)",
    "Detailed reporting: API reports, reward code/link reports, payment and wallet reports",
    "Role-based access control with Maker-Checker governance",
    "ISO 27001, SOC 2, and CSA certified infrastructure",
    "REST APIs: Gift Cards, Reward Points, Reward Link, Perks, and Marketplace"
  ],
  "publicApiSurface": [
    "GET /get-filters — Retrieve catalog filters (Gift Cards API)",
    "POST /place-order — Place a gift card order (Gift Cards API)",
    "GET /get-order-details — Fetch order details (Gift Cards API)",
    "GET /get-payment-report — Retrieve payment report (Gift Cards API)",
    "GET /get-vouchers — Fetch voucher details (Gift Cards API)",
    "POST /send-link — Send a reward link (Reward Link API)",
    "GET /validate-token — Validate an access token",
    "POST /refresh-token — Refresh an access token",
    "GET /fetch-offers — Retrieve available perks/offers (Perks API)",
    "GET /fetch-points — Fetch reward points balance (Reward Points API)",
    "POST /send-points — Send reward points (Reward Points API)",
    "GET /get-balance — Get account balance (Marketplace API)",
    "POST /refund — Initiate a refund (Marketplace API)"
  ]
